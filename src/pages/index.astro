---
import Layout from '../layouts/Layout.astro';
import { Section, Container, Block, Link } from '../../devlink/_Builtin/Basic';

const pages = import.meta.glob("../answers/**/index.html", {
  query: '?raw',
  import: 'default',
  eager: true,
});

console.log("Available answers:", Object.keys(pages));

const pageSlugs = Object.keys(pages).map((key) => {
  const href = key
    .replace("../answers/", "/answers/")
    .replace("/index.html", "");

    const title = (href.split("/").pop() || '').replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    return { href, title };
})

console.log("Page slugs:", pageSlugs);

---

<Layout>
  <Section
    client:load
    tag="section"
    className="margin-bottom-24px"
    style={{
      minHeight: '100vh',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center'
    }}
  >
    <Container>
      <Block
        tag="div"

        style={{
          maxWidth: '800px',
          margin: '0 auto'
        }}
      >
        <h1>aytm answers</h1>
        <nav style={{ columns: '3', gap: '16px' }}>
         {pageSlugs.map(({ href, title }:{ href: string; title: string }) => (
            href && <a
              href={href}
              style={{
                display: 'block',
                marginTop: '8px',
                marginBottom: '8px',
                padding: '8px',
                textDecoration: 'none',
                fontWeight: '600',
              }}
            >
              {title}
            </a>
          ))}
        </nav>
      </Block>
    </Container>
  </Section>
</Layout>

<style>
  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .button-primary {
    border-radius: 4px;
    background: #146ef5;
    color: #ffffff;
    box-shadow: 0px 0.5px 1px rgba(0, 0, 0, 0.25), inset 0px 29px 23px -16px rgba(255, 255, 255, 0.04), inset 0px 0.5px 0.5px rgba(255, 255, 255, 0.2);
  }

  .button-primary:hover {
    background: #2c80fd;
    color: #ffffff;
  }
</style>
